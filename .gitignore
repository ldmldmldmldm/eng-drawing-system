.DS_Store
Thumbs.db

.idea/
!.idea/.gitignore
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json
.history/
*.iml
*.ipr
*.iws
*.swp
*.sw?

/logs/*
!/logs/.gitkeep
*.log
*.log.*
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

/tmp/*
!/tmp/.gitkeep
temp/

# 生产后端构建用 Linux ODA deb（体积大，勿入库；随打包 tar 上传）
/docs/deploy/docker/prod/backend/ODAFileConverter_lnxX64.deb
/docs/deploy/docker/prod/backend/ODAFileConverter*.deb
.temp/
.cache/
.turbo/
*.pid
*.seed
*.pid.lock
*.tmp

# 业务运行时数据（STP/层次/产物）
/data/*
!/data/.gitkeep

**/target/
**/build/
**/.gradle/
**/.flattened-pom.xml
*.class
hs_err_pid*
replay_pid*

!**/.mvn/wrapper/maven-wrapper.jar

**/application-local.yml
**/application-local.yaml
**/application-dev.local.yml
**/.vscode
**/.workbuddy

**/node_modules/
**/dist/
**/dist-ssr/
**/.vite/
**/.output/
**/coverage/
*.tsbuildinfo
.npm
.pnpm-store/

*.zip
*.tar
*.tar.gz
*.tgz
*.war
*.jar
*.ear

.env
.env.*
*.key
